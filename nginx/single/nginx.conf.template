worker_processes 1;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;
events { worker_connections 256; }
http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    server_tokens off;
    access_log /dev/stdout;
    sendfile on;
    gzip on;
    gzip_proxied off;
    gzip_types text/css application/javascript;
    keepalive_timeout 20s;
    client_body_temp_path /tmp/nginx/client;
    proxy_temp_path /tmp/nginx/proxy;
    fastcgi_temp_path /tmp/nginx/fastcgi;
    uwsgi_temp_path /tmp/nginx/uwsgi;
    scgi_temp_path /tmp/nginx/scgi;
    client_max_body_size 1m;
    resolver 127.0.0.11 valid=10s ipv6=off;
    resolver_timeout 5s;
    upstream public_api { zone public_api 64k; server backend:8000 resolve; keepalive 8; }
    map $http_upgrade $connection_upgrade { default upgrade; '' close; }
    set_real_ip_from ${GATEWAY_CIDR};
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;
    geo $realip_remote_addr $reviewed_gateway {
        default 0;
        ${GATEWAY_CIDR} 1;
    }
    map "$reviewed_gateway:$http_x_forwarded_proto" $secure_ingress {
        default 0;
        "1:https" 1;
    }
    limit_req_zone $binary_remote_addr zone=single_api:1m rate=20r/s;
    limit_req_zone $binary_remote_addr zone=single_auth:1m rate=1r/s;
    limit_req_zone $binary_remote_addr zone=single_admin:1m rate=5r/s;
    limit_req_status 429;
    server {
        listen 8080 default_server;
        server_name _;
        location = /healthz { access_log off; return 200 "ok\n"; }
        location / { return 444; }
    }
    server {
        listen 8080;
        server_name ${PUBLIC_HOST};
        root /usr/share/nginx/html/public;
        if ($secure_ingress = 0) { return 403; }
        location = /admin { return 308 /admin/; }
        location /admin/ {
            include /etc/nginx/admin-security.inc;
            add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
            add_header Cache-Control "no-store" always;
            try_files $uri $uri/ /admin/index.html;
        }
        location ^~ /api/admin/auth/ {
            include /etc/nginx/admin-security.inc;
            add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
            limit_req zone=single_auth burst=10 nodelay;
            include /etc/nginx/proxy-common.inc;
            proxy_set_header Connection "";
        }
        location ^~ /api/admin/ {
            include /etc/nginx/admin-security.inc;
            add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
            limit_req zone=single_admin burst=20 nodelay;
            include /etc/nginx/proxy-common.inc;
            proxy_set_header Connection "";
        }
        location ^~ /api/internal/ { return 404; }
        location ^~ /metrics { return 404; }
        location = /api/ws/prices {
            include /etc/nginx/public-security.inc;
            add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
            include /etc/nginx/proxy-common.inc;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
        }
        location ^~ /api/auth/ {
            include /etc/nginx/public-security.inc;
            add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
            limit_req zone=single_auth burst=10 nodelay;
            include /etc/nginx/proxy-common.inc;
            proxy_set_header Connection "";
        }
        location /api/ {
            include /etc/nginx/public-security.inc;
            add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
            limit_req zone=single_api burst=40 nodelay;
            include /etc/nginx/proxy-common.inc;
            proxy_set_header Connection "";
        }
        location /assets/ {
            include /etc/nginx/public-security.inc;
            add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
            add_header Cache-Control "public, max-age=31536000, immutable" always;
            try_files $uri =404;
        }
        location = /sw.js {
            include /etc/nginx/public-security.inc;
            add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
            add_header Cache-Control "no-store" always;
            try_files $uri =404;
        }
        location = /manifest.webmanifest {
            include /etc/nginx/public-security.inc;
            add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
            add_header Cache-Control "no-cache" always;
            try_files $uri =404;
        }
        location ~ (^|/)\. { return 404; }
        location / {
            include /etc/nginx/public-security.inc;
            add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
            add_header Cache-Control "no-store" always;
            try_files $uri $uri/ /index.html;
        }
    }
    server {
        listen 8080;
        server_name ${ADMIN_HOST};
        root /usr/share/nginx/html/admin;
        if ($secure_ingress = 0) { return 403; }
        location = / { return 308 /admin/; }
        location ^~ /api/admin/auth/ {
            include /etc/nginx/admin-security.inc;
            add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
            limit_req zone=single_auth burst=10 nodelay;
            include /etc/nginx/proxy-common.inc;
            proxy_set_header Connection "";
        }
        location ^~ /api/admin/ {
            include /etc/nginx/admin-security.inc;
            add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
            limit_req zone=single_admin burst=20 nodelay;
            include /etc/nginx/proxy-common.inc;
            proxy_set_header Connection "";
        }
        location /api/ { return 404; }
        location ~ (^|/)\. { return 404; }
        location /assets/ {
            include /etc/nginx/admin-security.inc;
            add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
            add_header Cache-Control "public, max-age=31536000, immutable" always;
            try_files $uri =404;
        }
        location / {
            include /etc/nginx/admin-security.inc;
            add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
            add_header Cache-Control "no-store" always;
            try_files $uri $uri/ /admin/index.html;
        }
    }
}
