worker_processes 1;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;
events { worker_connections 256; }
http {
    # Published CDN ranges reviewed 2026-11-21: https://www.arvancloud.ir/fa/ips.txt
    set_real_ip_from 185.143.232.0/22;
    set_real_ip_from 188.229.116.16/30;
    set_real_ip_from 94.101.182.0/27;
    set_real_ip_from 2.144.3.128/28;
    set_real_ip_from 37.32.16.0/27;
    set_real_ip_from 37.32.17.0/27;
    set_real_ip_from 37.32.18.0/27;
    set_real_ip_from 37.32.19.0/27;
    set_real_ip_from 185.215.232.0/22;
    set_real_ip_from 178.131.120.48/28;
    set_real_ip_from 94.101.183.0/28;
    set_real_ip_from 78.157.36.112/28;
    set_real_ip_from 95.38.61.80/28;
    set_real_ip_from 193.24.119.0/29;
    real_ip_header X-Real-IP;
    geo $realip_remote_addr $nerkhbaan_cdn_peer {
        default 0;
        185.143.232.0/22 1;
        188.229.116.16/30 1;
        94.101.182.0/27 1;
        2.144.3.128/28 1;
        37.32.16.0/27 1;
        37.32.17.0/27 1;
        37.32.18.0/27 1;
        37.32.19.0/27 1;
        185.215.232.0/22 1;
        178.131.120.48/28 1;
        94.101.183.0/28 1;
        78.157.36.112/28 1;
        95.38.61.80/28 1;
        193.24.119.0/29 1;
    }
    map "$nerkhbaan_cdn_peer:$http_x_forwarded_proto" $nerkhbaan_redirect_http {
        default 0;
        ~*^1:http$ 1;
    }
    server_tokens off;
    gzip on;
    gzip_comp_level 2;
    gzip_min_length 1024;
    gzip_types application/json application/javascript text/css;
    gzip_proxied any;
    gzip_vary on;
    access_log /dev/stdout;
    client_max_body_size 1m;
    client_body_temp_path /tmp/client;
    proxy_temp_path /tmp/proxy;
    fastcgi_temp_path /tmp/fastcgi;
    uwsgi_temp_path /tmp/uwsgi;
    scgi_temp_path /tmp/scgi;
    resolver 127.0.0.11 valid=10s ipv6=off;
    upstream initial_web { zone initial_web 64k; server nerkhbaan-initial-web:8080 resolve; keepalive 8; }
    map $http_upgrade $upgrade_connection { default upgrade; '' close; }
    server {
        listen 8081 default_server;
        server_name _;
        location = /healthz { access_log off; return 200 "ok\n"; }
        location ^~ /.well-known/acme-challenge/ { root /var/www/acme; default_type text/plain; }
        location / { return 308 https://nerkhbaan.ir$request_uri; }
    }
    server {
        listen 8443 ssl default_server;
        ssl_reject_handshake on;
    }
    server {
        listen 8443 ssl;
        server_name nerkhbaan.ir;
        if ($nerkhbaan_redirect_http) { return 308 https://nerkhbaan.ir$request_uri; }
        http2 on;
        ssl_certificate /etc/nginx/tls/fullchain.pem;
        ssl_certificate_key /etc/nginx/tls/privkey.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_session_cache shared:InitialTLS:1m;
        ssl_session_tickets off;
        location ^~ /.well-known/acme-challenge/ { root /var/www/acme; default_type text/plain; }
        location / {
            proxy_pass http://initial_web;
            proxy_http_version 1.1;
            proxy_set_header Host nerkhbaan.ir;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $upgrade_connection;
            proxy_connect_timeout 5s;
            proxy_read_timeout 75s;
        }
    }
}
