{
  "name": "nerkhbaan-monorepo",
  "version": "2.8.7",
  "private": true,
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": "22.23.0",
    "npm": "10.9.8"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "cd apps/api && (venv/Scripts/uvicorn.exe app.main:app --reload --host 0.0.0.0 --port 8000 || venv/bin/uvicorn app.main:app --reload --host 0.0.0.0 --port 8000)",
    "dev:web": "npm run dev --workspace=nerkhbaan-web",
    "dev:admin": "npm run dev --workspace=nerkhbaan-admin-web",
    "dev:desktop": "npm run dev --workspace=nerkhbaan-desktop",
    "dev:all": "concurrently \"npm run dev:api\" \"npm run dev:web\" \"npm run dev:desktop\"",
    "build:web": "npm run build --workspace=nerkhbaan-web",
    "build:desktop": "npm run build --workspace=nerkhbaan-desktop",
    "build:admin": "npm run build --workspace=nerkhbaan-admin-web",
    "build": "npm run build:web && npm run build:admin && npm run build:desktop",
    "check:api": "cd apps/api && python -m compileall app && python -m pyflakes app tests scripts",
    "check:release": "node scripts/check-release-version.mjs",
    "test:api": "cd apps/api && python -m unittest discover -s tests -v",
    "test:frontend": "node --test scripts/frontend-contracts.test.mjs scripts/client-runtime.test.mjs scripts/app-context-runtime.test.mjs scripts/admin-runtime.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:logout": "playwright test --config scripts/playwright-logout.config.ts",
    "test:desktop": "node scripts/desktop-smoke.mjs",
    "test": "npm run test:api",
    "verify": "npm run check:release && npm run check:api && npm run check:ui && npm run test:api && npm run test:frontend && npm run build && npm run test:e2e",
    "check:ui": "npm run typecheck --workspace=@nerkhbaan/ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "typescript": "5.9.3",
    "yaml": "2.9.1",
    "vite": "6.4.3"
  },
  "overrides": {
    "source-map-js": "^1.2.2",
    "http-cache-semantics": "4.3.0",
    "global-agent": "4.1.3"
  }
}
