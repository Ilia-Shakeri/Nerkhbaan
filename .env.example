# ==========================================
# MONOREPO UNIFIED CONFIGURATION
# ==========================================

# Make `docker compose` use the production stack by default, so a bare
# `docker compose up -d --build` no longer picks docker-compose.yaml.
COMPOSE_FILE=docker-compose.prod.yaml

# ------------------------------------------
# 1. CORE BACKEND & DATABASE RUNTIME
# ------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false
ALLOWED_ORIGINS=https://nerkhbaan.ir,https://www.nerkhbaan.ir,http://localhost:5173,http://127.0.0.1:5173

DATABASE_URL=postgresql+psycopg://nerkhbaan:CHANGE_ME_SECURE_PASS@postgres:5432/nerkhbaan
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_USER=nerkhbaan
POSTGRES_DB=nerkhbaan

# ------------------------------------------
# 2. AUTHENTICATION & SECURITY
# ------------------------------------------
JWT_SECRET_KEY=change-this-to-a-secure-random-string-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
ADMIN_INITIAL_PASSWORD=your_secure_admin_password_here

# ------------------------------------------
# 3. CACHE & QUEUE
# ------------------------------------------
REDIS_URL=redis://redis:6379/0
PRICE_CACHE_FILE=price_cache.json

# ------------------------------------------
# 4. PRICING PROVIDERS & APIs
# ------------------------------------------
PRICING_REQUIRE_PROVIDER_KEYS=false

GOLD_API_BASE_URL=https://api.gold-api.com
GOLDAPI_API_KEY=

ALANCHAND_API_BASE_URL=https://api.alanchand.com
ALANCHAND_API_TOKEN=

METALS_DEV_API_BASE_URL=https://api.metals.dev/v1
METALS_DEV_API_KEY=

EXCHANGERATE_API_BASE_URL=https://v6.exchangerate-api.com/v6
EXCHANGERATE_API_KEY=

TGJU_API_BASE_URL=https://api.tgju.org/v1
NOBITEX_API_BASE_URL=https://api.nobitex.ir
TETHERLAND_API_BASE_URL=https://api.tetherland.com
BONBAST_API_BASE_URL=https://www.bonbast.com
COINGECKO_API_BASE_URL=https://api.coingecko.com/api/v3
COINCAP_API_BASE_URL=https://api.coincap.io/v2
FRANKFURTER_API_BASE_URL=https://api.frankfurter.app
EXCHANGE_RATE_API_BASE_URL=https://open.er-api.com/v6/latest

# ------------------------------------------
# 5. REASONING PROVIDER (CHART ANALYSIS + ASSISTANT)
# ------------------------------------------
# Chat-completions endpoint. Override the base URL, model, and key as needed.
INSIGHT_API_BASE_URL=https://api.deepseek.com
INSIGHT_API_KEY=
DEEPSEEK_API_KEY=
INSIGHT_MODEL=deepseek-chat

# ------------------------------------------
# 6. ALERT DELIVERY (WEB PUSH + EMAIL)
# ------------------------------------------
# Web push (VAPID). Generate one stable key pair; rotating it drops all
# existing browser subscriptions. Leave empty to disable push delivery.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alerts@nerkhbaan.ir

# SMTP for email alerts. Leave host empty to disable email delivery.
# See ALERT_SETUP.md for the full Telegram/SMS/Email provisioning guide.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Nerkhbaan Alerts <alerts@nerkhbaan.ir>
SMTP_USE_TLS=true

# ------------------------------------------
# 7. TELEGRAM MTProto INGESTION
# ------------------------------------------
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_STRING=
TELEGRAM_CHANNELS=

# ------------------------------------------
# 8. FRONTEND (VITE) ENVIRONMENT
# ------------------------------------------
VITE_API_URL=http://127.0.0.1:8000/api
VITE_ENABLE_DEMO_LOGIN=true
