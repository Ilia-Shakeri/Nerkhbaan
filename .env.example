# Compose uses the production stack for the normal one-command deployment.
COMPOSE_FILE=docker-compose.prod.yaml
# Set to admin, telegram, or admin,telegram to start optional services.
COMPOSE_PROFILES=

# Core runtime
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false
LOG_LEVEL=INFO
PUBLIC_FRONTEND_ORIGIN=https://nerkhbaan.ir
ADMIN_FRONTEND_ORIGIN=https://admin.nerkhbaan.ir
ALLOWED_ORIGINS=https://nerkhbaan.ir,https://www.nerkhbaan.ir,https://admin.nerkhbaan.ir
TRUSTED_HOSTS=nerkhbaan.ir,www.nerkhbaan.ir,admin.nerkhbaan.ir,localhost,127.0.0.1
TRUSTED_PROXY_IPS=127.0.0.1,::1
FORWARDED_ALLOW_IPS=127.0.0.1,172.28.0.0/24
MAX_REQUEST_BODY_BYTES=1048576
REQUEST_ID_HEADER=X-Request-ID

# Database and migration service
POSTGRES_USER=nerkhbaan
POSTGRES_DB=nerkhbaan
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://nerkhbaan:SET_DATABASE_PASSWORD@postgres:5432/nerkhbaan
MIGRATION_ADVISORY_LOCK_ID=7265172091
MIGRATION_CONNECT_TIMEOUT_SECONDS=10
MIGRATION_STATEMENT_TIMEOUT_SECONDS=300

# Public sessions
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=15
JWT_ISSUER=nerkhbaan-api
JWT_AUDIENCE=nerkhbaan-clients
AUTH_COOKIE_ENABLED=true
AUTH_COOKIE_NAME=nerkhbaan_session
AUTH_REFRESH_COOKIE_NAME=nerkhbaan_refresh
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=strict
AUTH_COOKIE_DOMAIN=.nerkhbaan.ir
AUTH_REFRESH_DAYS=30
AUTH_REFRESH_PATH=/api/auth
AUTH_RETURN_BEARER_TOKEN=true

# Administrative access and bootstrap
ADMIN_FRONTEND_ENABLED=true
ADMIN_COOKIE_NAME=nerkhbaan_admin_session
ADMIN_REFRESH_COOKIE_NAME=nerkhbaan_admin_refresh
ADMIN_COOKIE_DOMAIN=admin.nerkhbaan.ir
ADMIN_COOKIE_SECURE=true
ADMIN_COOKIE_SAMESITE=strict
ADMIN_SESSION_MINUTES=30
ADMIN_REFRESH_HOURS=12
ADMIN_REAUTH_MINUTES=10
ADMIN_LOGIN_FAILURE_LIMIT=5
ADMIN_LOCKOUT_MINUTES=30
ADMIN_IP_ALLOWLIST=
ADMIN_PRIVATE_NETWORK_ONLY=false
ADMIN_SESSION_BIND_IP=false
ADMIN_SESSION_BIND_USER_AGENT=true
# Set all four bootstrap values together. The password must have 14 or more
# characters and include upper, lower, number, and symbol characters.
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_FULL_NAME=

# Redis coordination, streams, and cache policy
REDIS_URL=redis://redis:6379/0
PRICING_PERSISTENCE_STREAM_MAXLEN=100000
PRICING_EVENT_STREAM_MAXLEN=20000
PRICING_LOCK_TTL_SECONDS=45
PRICING_REFRESH_INTERVAL_SECONDS=20
PRICING_REFRESH_JITTER_SECONDS=8
PRICING_PROVIDER_CACHE_GRACE_SECONDS=300

# Pricing policy overrides use JSON objects keyed by provider or instrument ID.
PRICING_REQUIRE_PROVIDER_KEYS=false
PRICING_PROVIDER_BUDGET_OVERRIDES={}
PRICING_INSTRUMENT_TTL_OVERRIDES={}
PRICING_ANOMALY_THRESHOLD_OVERRIDES={}
PRICING_DERIVED_FALLBACK_ENABLED=true
PRICING_BACKFILL_ENABLED=true
PRICING_BACKFILL_BATCH_SIZE=500
PRICING_BACKFILL_MAX_JOBS_PER_CYCLE=2
PRICING_PERSISTENCE_FLUSH_BATCH_SIZE=200
PRICING_PERSISTENCE_FLUSH_INTERVAL_SECONDS=5
RAW_PROVIDER_PAYLOAD_MAX_BYTES=16384
RAW_PROVIDER_PAYLOAD_RETENTION_DAYS=30

# WebSocket and polling behavior
WEBSOCKET_HEARTBEAT_SECONDS=20
WEBSOCKET_CLIENT_TIMEOUT_SECONDS=60
WEBSOCKET_POLL_FALLBACK_SECONDS=30
WEBSOCKET_MAX_CONNECTIONS_PER_WORKER=1000
VITE_WS_URL=wss://nerkhbaan.ir/api/ws/prices
VITE_WS_RECONNECT_BASE_MS=1000
VITE_WS_RECONNECT_MAX_MS=30000
VITE_PRICE_POLL_INTERVAL_MS=30000

# Provider endpoints and optional credentials
GOLD_API_BASE_URL=https://api.gold-api.com
GOLDAPI_API_BASE_URL=https://www.goldapi.io/api
GOLDAPI_API_KEY=
ALANCHAND_API_BASE_URL=https://api.alanchand.com
ALANCHAND_API_TOKEN=
METALS_DEV_API_BASE_URL=https://api.metals.dev/v1
METALS_DEV_API_KEY=
EXCHANGERATE_API_BASE_URL=https://v6.exchangerate-api.com/v6
EXCHANGERATE_API_KEY=
TGJU_API_BASE_URL=https://api.tgju.org/v1
NOBITEX_API_BASE_URL=https://api.nobitex.ir
WALLEX_API_BASE_URL=https://api.wallex.ir
TETHERLAND_API_BASE_URL=https://api.tetherland.com
BONBAST_API_BASE_URL=https://www.bonbast.com
COINBASE_API_BASE_URL=https://api.exchange.coinbase.com
COINGECKO_API_BASE_URL=https://api.coingecko.com/api/v3
COINGECKO_API_KEY=
COINCAP_API_BASE_URL=https://api.coincap.io/v2
FRANKFURTER_API_BASE_URL=https://api.frankfurter.app
EXCHANGE_RATE_API_BASE_URL=https://open.er-api.com/v6/latest
SERVIX_API_BASE_URL=https://servix.cc
SERVIX_API_KEY=
TALA_API_BASE_URL=https://api.tala.ir
TALA_API_KEY=
TALA_XAU_USD_KEY=ons
TALA_XAG_USD_KEY=silver
TALA_USDT_TOMAN_KEY=usdt_irt
TALA_GOLD18_TOMAN_KEY=geram18k
TALA_GOLD24_TOMAN_KEY=geram24k
TALA_SILVER999_TOMAN_KEY=
TICARO_API_BASE_URL=https://ticaro.ir
TICARO_API_KEY=
TICARO_USDT_TOMAN_PAIR=USDT/TMN
TICARO_BTC_TOMAN_PAIR=BTC/TMN
TICARO_GOLD18_TOMAN_PAIR=GOLD18/TMN
TICARO_GOLD24_TOMAN_PAIR=
TICARO_SILVER999_TOMAN_PAIR=
ARZBIN_API_BASE_URL=https://hub.arzbin.com
ARZBIN_API_KEY=
ARZBIN_LOCAL_UNIT=TOMAN
ARZBIN_PRICE_SEMANTIC=sell
NAVASAN_API_BASE_URL=http://api.navasan.tech
NAVASAN_HTTPS_PROXY_BASE_URL=
NAVASAN_API_KEY=
NAVASAN_ALLOW_INSECURE_HTTP=false
NAVASAN_USD_ITEM=usd_sell
NAVASAN_USDT_ITEM=usdt
NAVASAN_BTC_ITEM=btc
NAVASAN_GOLD18_ITEM=18ayar
NAVASAN_XAU_ITEM=usd_xau
NERKH_IO_API_BASE_URL=https://api.nerkh.io
NERKH_IO_BEARER_TOKEN=
NERKH_IO_API_KEY=
NERKH_IO_CURRENCY_UNIT=
NERKH_IO_GOLD_UNIT=
NERKH_IO_CRYPTO_UNIT=
NERKH_IO_USD_SYMBOL=USD
NERKH_IO_USDT_SYMBOL=USDT
NERKH_IO_BTC_SYMBOL=BTC
NERKH_IO_GOLD18_SYMBOL=GOLD18K
NERKH_IO_GOLD24_SYMBOL=GOLD24K
NERKH_IO_XAU_SYMBOL=OUNCE
NERKH_IO_XAG_SYMBOL=OUNCE_SILVER
USDT_USD_SAFE_MIN=0.97
USDT_USD_SAFE_MAX=1.03
TROY_OUNCE_GRAMS=31.1034768
PRICING_PROVIDER_CONNECT_TIMEOUT_SECONDS=3
PRICING_PROVIDER_REQUEST_TIMEOUT_SECONDS=10
PRICING_PROVIDER_MAX_RETRIES=2
PRICING_PROVIDER_BACKOFF_BASE_SECONDS=0.5
PRICING_PROVIDER_AGGREGATE_CACHE_SECONDS=5
PRICING_PROVIDER_MAX_RESPONSE_BYTES=262144
PRICING_PROVIDER_ALLOWED_HOSTS=api.gold-api.com,www.goldapi.io,api.metals.dev,api.exchange.coinbase.com,api.coingecko.com,api.nobitex.ir,api.wallex.ir,api.tetherland.com,servix.cc,api.tala.ir,ticaro.ir,hub.arzbin.com,api.navasan.tech,api.nerkh.io
SECRET_MANAGER_PROVIDER=env
SECRET_ROTATION_RUNBOOK_URL=
PRICING_PROVIDER_COINCAP_BTC_ENABLED=false
PRICING_PROVIDER_COINCAP_USDT_ENABLED=false
PRICING_PROVIDER_SERVIX_BTC_USD_ENABLED=false
PRICING_PROVIDER_TALA_GOLD18_TOMAN_ENABLED=false
PRICING_PROVIDER_TALA_GOLD24_TOMAN_ENABLED=false
PRICING_PROVIDER_TALA_USDT_TOMAN_ENABLED=false
PRICING_PROVIDER_NAVASAN_USDT_ENABLED=false
PRICING_PROVIDER_NERKH_IO_GOLD24_ENABLED=false

# Smart Analysis and Smart Assistant providers
AI_PROVIDER_ORDER=groq,gemini,openrouter,deepseek
INSIGHT_API_BASE_URL=https://api.deepseek.com
INSIGHT_API_KEY=
DEEPSEEK_API_KEY=
INSIGHT_MODEL=deepseek-v4-flash
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
OPENROUTER_API_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
AI_ALLOW_OPENROUTER_FREE=false
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
AI_REQUEST_TIMEOUT_SECONDS=25
AI_MAX_RETRIES=2
AI_MAX_TOKENS=600
AI_USER_DAILY_REQUEST_LIMIT=20
AI_GLOBAL_DAILY_REQUEST_LIMIT=500
AI_DEDUPLICATION_WINDOW_SECONDS=15

# Alert workers and delivery
ALERT_WORKER_POLL_SECONDS=5
ALERT_DELIVERY_MAX_ATTEMPTS=6
ALERT_DELIVERY_BACKOFF_BASE_SECONDS=30
ALERT_DELIVERY_BACKOFF_MAX_SECONDS=3600
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alerts@nerkhbaan.ir
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Nerkhbaan Alerts <alerts@nerkhbaan.ir>
SMTP_USE_TLS=true
TELEGRAM_ALERT_DELIVERY_ENABLED=false
TELEGRAM_BOT_TOKEN=
# Public bot account name, with or without the leading @.
TELEGRAM_BOT_USERNAME=
# Enable only after the HTTPS webhook and both independent secrets are set.
TELEGRAM_DEEPLINK_ENABLED=false
# Signed start links expire after 60 to 3600 seconds.
TELEGRAM_DEEPLINK_TTL_SECONDS=600
# Use separate random values of at least 16 characters for these two secrets.
TELEGRAM_DEEPLINK_SIGNING_SECRET=
TELEGRAM_WEBHOOK_SECRET=

# Optional Telegram source ingestion profile
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_STRING=
TELEGRAM_CHANNELS=
TELEGRAM_STORE_SANITIZED_TEXT=false

# Frontend build values
VITE_API_URL=/api
VITE_ADMIN_API_URL=/api/admin
VITE_PUBLIC_ORIGIN=https://nerkhbaan.ir
VITE_ADMIN_ORIGIN=https://admin.nerkhbaan.ir
VITE_ENABLE_DEMO_LOGIN=false
