[Unit]
Description=Nerkhbaan external price worker
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=nerkhbaan-sync
Group=nerkhbaan-sync
EnvironmentFile=/etc/nerkhbaan-price-worker.env
ExecStart=/usr/bin/python3 /opt/nerkhbaan-price-worker/worker.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/nerkhbaan-price-worker
