NERKHBAAN_WORKER_ENDPOINT=https://nerkhbaan.ir/api/internal/pricing-worker
NERKHBAAN_WORKER_SECRET=replace-with-the-same-32-plus-character-secret-on-the-core
# Optional absolute private production grant file. Empty uses reviewed built-in
# Gold XAU/XAG/BTC application grants. Each route needs collect, store and
# own_app_transport. Public relay is denied by default.
PRICING_RIGHTS_MANIFEST_PATH=
# Old progress is preserved. No approved historical request currently runs.
NERKHBAAN_WORKER_STATE_FILE=/var/lib/nerkhbaan-price-worker/history-complete
